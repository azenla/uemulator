#!/usr/bin/expect -f
# usage: boot.exp MACHINE LOG TIMEOUT_SECONDS [PATTERN] [quick boot args...]
# Boots a machine, logs everything, stops at PATTERN (default "login:") or the timeout.
set machine [lindex $argv 0]
log_file -a [lindex $argv 1]
set timeout [lindex $argv 2]
set pattern [expr {[llength $argv] > 3 ? [lindex $argv 3] : "login:"}]
set extra [lrange $argv 4 end]
set start [clock seconds]
eval spawn ./target/release/uemulator quick boot $machine $extra
expect {
    $pattern { puts "\nboot.exp: matched after [expr {[clock seconds] - $start}] s" }
    timeout { puts "\nboot.exp: timeout" }
    eof { puts "\nboot.exp: eof after [expr {[clock seconds] - $start}] s" }
}
